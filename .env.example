# =============================================================================
# Industrial Agent — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# .env is gitignored and will NEVER be committed to GitHub.
# =============================================================================

# ---------------------------------------------------------------------------
# Dataset Location
# ---------------------------------------------------------------------------
# Absolute path to the folder containing all CSV dataset files.
# Default search order (if left blank):
#   1. This variable
#   2. C:/Projects/industrial_agent
#   3. Repository root
INDUSTRIAL_DATA_DIR=C:/Projects/industrial_agent

# ---------------------------------------------------------------------------
# LLM API Keys (fill in whichever backend you use in Phase 4)
# ---------------------------------------------------------------------------

# Google Gemini (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI GPT-4o (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# ---------------------------------------------------------------------------
# LLM Backend Selection (used in Phase 4 agent core)
# ---------------------------------------------------------------------------
# Options: gemini | openai
LLM_BACKEND=gemini

# Model name (examples below — pick one)
# Gemini:  gemini-2.5-flash  |  gemini-2.5-pro
# OpenAI:  gpt-4o            |  gpt-4o-mini
LLM_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Agent Behaviour (optional tuning)
# ---------------------------------------------------------------------------
# Max LLM reasoning steps before forcing a final answer
AGENT_MAX_STEPS=10

# Temperature (0.0 = deterministic, 1.0 = creative)
AGENT_TEMPERATURE=0.2

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
